// Lokal (sandbox/dev): SQLite file DB — cepat & tanpa kredensial eksternal.
// Untuk deploy Vercel/Supabase, aktifkan kembali blok postgresql di bawah.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

