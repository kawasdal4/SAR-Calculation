// === DEPLOY (Vercel + Supabase PostgreSQL) — AKTIF ===
// Client untuk production dibangun dari schema ini saat build di Vercel.
// binaryTargets: runtime Vercel = rhel-openssl-3.0.x; native = dev di Linux.
// Catatan pooler Supabase: prepared statement dinonaktifkan lewat parameter
// URL DATABASE_URL (?pgbouncer=true pada port 6543) — bukan properti schema
// (properti `pgbouncer` sudah dihapus sejak Prisma 5).
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// === LOKAL (sandbox/dev) — SQLite ===
// Skema SQLite dipindah ke prisma/schema.sqlite.prisma agar dev lokal tidak
// butuh kredensial eksternal. Script db:* di package.json menunjuk ke sana.

/// A saved SAR mission case — captures all worksheet inputs as JSON.
model SarCase {
  id          String   @id @default(cuid())
  /// Human-friendly case title (e.g., "M/V NEVERSEEN — Java Sea").
  title       String
  /// Optional case number for cross-reference with RCC files.
  caseNumber  String?
  /// Search object description (e.g., "8-person orange liferaft with canopy").
  searchObject String?
  /// Emergency phase: UNCERTAINTY | ALERT | DISTRESS
  phase       String  @default("DISTRESS")
  /// Serialized full worksheet state (JSON).
  /// Shape: { awa, asw, datum (start, env, lw, X, Y), search (facilities, sweep, datumType, conditions) }
  state       String
  /// Optional notes for the SMC.
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

/// Bank Data kasus — fakta terstruktur hasil analisis AI atas Soal Kasus
/// dan input manual petugas, lengkap dengan provenance per field.
/// Merujuk Panduan Agent RENOPS/Briefing/De-Briefing (Perban 3/2020).
model CaseDataBank {
  id        String   @id @default(cuid())
  /// Optional link ke SarCase.id bila kasus sudah disimpan.
  caseId    String?
  caseTitle String?
  /// Jenis kejadian hasil analisis: ACCIDENT (kapal/pesawat) | DISASTER (bencana/KKM).
  incidentType String @default("ACCIDENT")
  /// Teks Soal Kasus asli yang dianalisis.
  rawText   String
  /// JSON array of DataBankField: { key, label, value, unit, sourceType, sourceRef, status, plannedActual, question }
  fields    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId])
}

/// Draft dokumen resmi (RENOPS Format I/II, Briefing, De-Briefing)
/// hasil generator dengan resolusi sumber worksheet → peta → bank data.
model DocumentDraft {
  id        String   @id @default(cuid())
  caseId    String?
  bankId    String?
  /// RENOPS_I | RENOPS_II | BRIEFING | DEBRIEFING
  docType   String
  /// DRAFT | APPROVED
  status    String   @default("DRAFT")
  /// JSON: { sections, validation, questions, meta }
  payload   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId, docType])
}

/// SAR Workflow Memory — konteks terstruktur per workspace (SarCase).
/// Append-only: versi baru = baris baru; hasil lama TIDAK pernah dihapus
/// (status jadi ARCHIVED dengan supersededBy) sesuai kebijakan retensi &
/// versioning (audit trail). Workspace = SarCase existing — bukan entitas baru.
model WorkspaceContext {
  id        String   @id @default(cuid())
  /// Link ke SarCase.id — workspace identifier (wajib, isolation antar workspace).
  caseId    String
  /// Slot stabil: 'calc:awa' | 'calc:ws1-datum' | 'map:features' | 'conv:<ts>' | 'doc:renops' …
  entryKey  String
  /// A: scenario | B: calculation | C: map | D: operational | E: conversation
  category  String
  /// Capability registry id sumber (env-awa, ws1-datum, map-sea-render, …).
  capabilityId String?
  /// Referensi hasil kalkulasi/objek (mis. id pola, id dokumen).
  calculationId String?
  /// 'user-input' | 'ai-extraction' | 'worksheet' | 'map' | 'document' | 'conversation'
  source    String   @default("user-input")
  /// JSON data entry (snapshot nilai + ringkasan) — tanpa API key/secret.
  data      String
  /// CURRENT | STALE | PENDING | NEEDS_REVIEW | INVALID | ARCHIVED
  status    String   @default("CURRENT")
  /// Ringkasan satu baris untuk retrieval selektif AI.
  summary   String?
  /// Versi monoton per entryKey.
  version   Int      @default(1)
  /// Hash input sumber — dasar deteksi STALE.
  inputsHash String?
  /// JSON array: entryKey dependency (relasi aktual, bukan tebakan).
  dependencies String @default("[]")
  /// entryKey versi yang digantikan oleh baris ini (untuk histori).
  supersededBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId, entryKey])
  @@index([caseId, status])
}

/// Akun pengguna portal — dibuat oleh role developer.
/// `identifier` berisi Email ATAU NIP (unik), dipakai untuk login.
model Account {
  id           String   @id @default(cuid())
  /// Email atau NIP — satu field unik untuk keduanya.
  identifier   String   @unique
  /// Nama lengkap petugas (opsional).
  name         String?
  /// Role akses: developer | operator. Akun baru default operator.
  role         String   @default("operator")
  /// Hash password (scrypt, format "salt:hash" hex).
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Change-log perubahan state worksheet — dasar UNDO per-batch AI (keputusan
/// implementasi no. 10). Satu "Konfirmasi & Terapkan" AI = satu batch atomic:
/// semua baris batch berbagi batchId, menyimpan nilai sebelum/sesudah, sehingga
/// rollback aman dan tidak menimpa perubahan manual setelahnya.
model CaseChangeLog {
  id          String   @id @default(cuid())
  /// Link ke SarCase.id bila workspace kasus aktif (opsional).
  caseId      String?
  /// Batch ID: semua perubahan satu aksi apply AI berbagi id yang sama.
  batchId     String
  /// Pemicu perubahan: "ai" | identifier akun pengguna.
  actor       String   @default("ai")
  /// Sumber: "ai-apply" | "manual" | "undo" | "load-case" | "generator".
  source      String   @default("ai-apply")
  /// Worksheet/section target: "asw" | "awa" | "aero" | "datum" | "ws2" | "ws3" | "ws8" | "ws4" | "assets" | "pattern" | "intercept" | "lkp" | "briefing" | "renops".
  worksheet   String
  /// Nama field TERDAFTAR di schema worksheet (bukan arbitrary path).
  field       String
  /// Nilai sebelum (JSON) — sumber rollback & audit.
  valueBefore String?
  /// Nilai sesudah (JSON) — audit.
  valueAfter  String?
  createdAt   DateTime @default(now())

  @@index([batchId])
  @@index([caseId, createdAt])
}

/// Log sesi AI (Fase 2): satu baris per turn percakapan. Menyimpan session,
/// model, interaction ID Interactions API (untuk previous_interaction_id),
/// status, pemakaian token (bila tersedia), dan ringkasan aktivitas tool.
/// TIDAK menyimpan API key ataupun dokumen mentah (base64) — hanya teks turn
/// yang dipangkas untuk fallback rebuild konteks (keputusan implementasi no. 4).
model AiSessionLog {
  id                String   @id @default(cuid())
  /// ID sesi percakapan dari client (UUID per panel chat).
  sessionId         String
  /// Bila kasus aktif: link ke SarCase.id.
  caseId            String?
  /// Interaction ID turn sebelumnya yang dipakai (previous_interaction_id).
  prevInteractionId String?
  /// Interaction ID hasil turn ini (dipakai turn berikutnya).
  interactionId     String?
  /// Nama model yang menjawab turn ini.
  model             String?
  /// ok | error | interaction-expired-fallback | no-api-key | timeout
  status            String   @default("ok")
  /// Pesan error ringkas (tanpa isi prompt, tanpa secret) bila status error.
  errorMessage      String?
  /// Pemakaian token bila tersedia: {inputTokens, outputTokens, totalTokens}.
  usageJson         String?
  /// Ringkasan tool: [{name, argKeys}] — bukan isi argumen mentah.
  toolCallsJson     String?
  /// Cuplikan teks user/assistant turn ini (maks 4000 char per sisi) —
  /// sumber fallback rebuild konteks bila interaction ID kedaluwarsa.
  turnJson          String?
  /// Durasi panggilan (ms).
  durationMs        Int?
  createdAt         DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([interactionId])
}

/// Bank master data lokasi & aset SAR (keputusan implementasi no. 7): draft
/// sampai disetujui pemilik. Setiap entri WAJIB membawa sumber + tanggal
/// pembaruan + satuan + status verifikasi; dilarang menebak koordinat/spesifikasi.
model CaseBankItem {
  id          String   @id @default(cuid())
  /// "location" (kantor SAR/bandara/pelabuhan/helipad) | "asset" (spesifikasi SRU).
  kind        String
  /// Nama entri: "Kantor SAR Banten", "Eurocopter AS-365 N3+", dst.
  name        String
  /// Kategori: kantor-sar | bandara | pelabuhan | helipad | helicopter | fixed-wing | vessel | ...
  category    String?
  /// Detail spesifikasi (JSON): koordinat DMS/desimal, endurance, TAS, visibility, radio, dll.
  specs       String
  /// Koordinat utama (desimal bertanda) bila relevan — untuk query peta.
  lat         Float?
  lng         Float?
  /// Sumber data wajib (dokumen/URL/soal PDF) — provenance.
  source      String?
  /// Tanggal pembaruan data (ISO string).
  updatedRef  String?
  /// Satuan yang dipakai di specs (mis. "kts, NM, ft, km").
  units       String?
  /// VERIFIED | UNVERIFIED | MISSING | SIMULATION (keputusan no. 6).
  verification String  @default("UNVERIFIED")
  /// DRAFT | APPROVED — data baru menunggu persetujuan (keputusan no. 7 & 12).
  approval    String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, approval])
}
