# OpenAIP key stays on the server; do not use NEXT_PUBLIC_ for this secret.
OPENAIP_API_KEY=

# Optional georeferenced ONC raster tiles. Public URL only, never place a secret here.
# Example after copying XYZ PNG tiles to public/data/onc/scan:
NEXT_PUBLIC_ONC_SCAN_TILE_URL=/data/onc/scan/{z}/{x}/{y}.png
