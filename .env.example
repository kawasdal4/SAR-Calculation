# Environment variables for SAR Calculation app

# Database URL — Supabase Postgres (recommended for Vercel)
# Format: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Note: URL-encode special characters in password (e.g. * → %2A, # → %23, $ → %24)
# DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# For local dev with SQLite (not for Vercel):
# DATABASE_URL="file:./db/custom.db"

# If DATABASE_URL is unset in production, the app falls back to an
# in-memory store (Save/Open Case works during the session only).
# DATABASE_URL=

# --- Optional: BATNAS bathymetry layer (BIG Indonesia) ---
# Set these to enable the BATNAS layer in the sea map. Both are optional;
# if unset, the layer checkbox is hidden and the app falls back to GEBCO WMS.
#
# NEXT_PUBLIC_BATNAS_TILES_URL — tile PNG endpoint (XYZ format {z}/{x}/{y}.png)
#   Example: https://your-storage.example.com/batnas/{z}/{x}/{y}.png
#   The host must allow CORS and serve PNG tiles in standard XYZ layout.
#
# NEXT_PUBLIC_BATNAS_COG_URL — Cloud Optimized GeoTIFF for depth-per-point queries
#   Example: https://your-storage.example.com/batnas.cog.tif
#   The host must allow CORS and HTTP Range requests.
#   When set, click-to-depth and polygon-depth-sampling use BATNAS COG
#   (read directly from browser via geotiff.js) instead of GEBCO WMS.
#
# NEXT_PUBLIC_BATNAS_TILES_URL=
# NEXT_PUBLIC_BATNAS_COG_URL=

# Optional: BMKG / Open-Meteo APIs don't require API keys.
# No other environment variables are required.
