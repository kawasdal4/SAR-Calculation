# Database: Supabase Postgres via connection pooler (transaction mode, IPv4).
# Password WAJIB di-URL-encode (mis. * -> %2A, # -> %23, $ -> %24).
# ?pgbouncer=true wajib: menonaktifkan prepared statement agar aman di transaction pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Koneksi langsung untuk migrasi (prisma db push / migrate).
# Di jaringan tanpa IPv6 gunakan session pooler (port 5432, host pooler).
DIRECT_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# OpenAIP key stays on the server; do not use NEXT_PUBLIC_ for this secret.
OPENAIP_API_KEY=

# === Login portal (WAJIB untuk login di Vercel) ===
# Secret HMAC token sesi — generate: openssl rand -hex 32
SAR_AUTH_SECRET=
# Fallback akun developer (dipakai bila tabel Account masih kosong).
# Ketiganya wajib terisi agar fallback aktif.
SAR_AUTH_USER=developer
SAR_AUTH_EMAIL=developer@sar.local
SAR_AUTH_PASSWORD=
# Password awal akun baru lewat menu Akun (default "SAR115").
SAR_ACCOUNT_DEFAULT_PASSWORD=

# Optional georeferenced ONC raster tiles. Public URL only, never place a secret here.
# Example after copying XYZ PNG tiles to public/data/onc/scan:
NEXT_PUBLIC_ONC_SCAN_TILE_URL=/data/onc/scan/{z}/{x}/{y}.png

# === AI Copilot (Fase 2) — server-side only, NEVER via NEXT_PUBLIC_* ===
# Gemini API key (aistudio.google.com/apikey). Empty = AI features disabled
# with a clear user-facing message. Client never stores/sends API keys.
GEMINI_API_KEY=
# Model selection (keputusan implementasi no.2): default gemini-3.8-flash.
# gemini-4-hydrogen hanya sebagai OPSI via GEMINI_MODEL_FALLBACKS setelah
# verifikasi kompatibilitas endpoint, akses model, dan biaya.
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL_AGENT=gemini-3.8-flash
# GEMINI_MODEL_EXTRACTION=gemini-3.8-flash
# GEMINI_MODEL_FALLBACKS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Timeout per percobaan & anggaran total (ms) — opsional:
# GEMINI_REQUEST_TIMEOUT_MS=120000
# GEMINI_TOTAL_BUDGET_MS=260000
