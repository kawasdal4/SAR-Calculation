# Environment variables for SAR Calculation app

# Database URL — Supabase Postgres (recommended for Vercel)
# Format: postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# Note: URL-encode special characters in password (e.g. * → %2A, # → %23, $ → %24)
# DATABASE_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# For local dev with SQLite (not for Vercel):
# DATABASE_URL="file:./db/custom.db"

# If DATABASE_URL is unset in production, the app falls back to an
# in-memory store (Save/Open Case works during the session only).
# DATABASE_URL=

# Optional: BMKG / Open-Meteo APIs don't require API keys.
# No other environment variables are required.
